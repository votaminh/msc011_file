%YAML 1.1
--- !XShader &1
name: layer_xshader
renderQueue: 2000
passes:
  - __class: Pass
    name: layer_pass
    shaders:
      __class: Map
      gles2:
        - {localId: 2}
        - {localId: 3}
    semantics:
      __class: Map
      a_position:
        __class: VertexAttribType
        value: POSITION
      a_texcoord:
        __class: VertexAttribType
        value: TEXCOORD0
    clearColor: {r: 0.5, g: 0.5, b: 0.5, a: 1}
    clearDepth: 1
    clearType:
      __class: CameraClearType
      value: DONT
    renderState:
      __class: RenderState
      name: ""
      viewport:
        __class: ViewportState
        name: ""
        rect: {x: 0, y: 0, w: 1, h: 1}
        rectName: ""
        minDepth: 0
        minDepthName: ""
        maxDepth: 1
        maxDepthName: ""
        portValueType:
          __class: PortValueType
          value: PERCENT
      depthstencil:
        __class: DepthStencilState
        name: ""
        depthTestEnable: false
        depthTestEnableName: ""
        depthCompareOp:
          __class: CompareOp
          value: LESS
        depthCompareOpName: ""
        depthWriteEnable: false
        stencilTestEnable: false
        stencilTestEnableName: ""
      colorBlend:
        __class: ColorBlendState
        name: ""
        blendConstants: {x: 0, y: 0, z: 0, w: 0}
        blendEnableName: ""
        blendFactorName: ""
        blendOpName: ""
        attachments:
          - __class: ColorBlendAttachmentState
            name: ""
            blendEnable: true
            srcColorBlendFactor:
              __class: BlendFactor
              value: SRC_ALPHA
            dstColorBlendFactor:
              __class: BlendFactor
              value: ONE_MINUS_SRC_ALPHA
            srcAlphaBlendFactor:
              __class: BlendFactor
              value: ONE
            dstAlphaBlendFactor:
              __class: BlendFactor
              value: ONE_MINUS_SRC_ALPHA
            colorWriteMask: 15
            ColorBlendOp:
              __class: BlendOp
              value: ADD
            AlphaBlendOp:
              __class: BlendOp
              value: ADD
    useFBOTexture: false
    useCameraRT: false
    useFBOFetch: false
    isFullScreenShading: false
    macrosMap:
      __class: Map
    preprocess: false
    passType:
      __class: PassType
      value: NORMAL
--- !Shader &2
name: ""
type:
  __class: ShaderType
  value: VERTEX
sourcePath: xshader/gles2_bhclbo.vert
--- !Shader &3
name: ""
type:
  __class: ShaderType
  value: FRAGMENT
sourcePath: xshader/gles2_vwxkyt.frag
