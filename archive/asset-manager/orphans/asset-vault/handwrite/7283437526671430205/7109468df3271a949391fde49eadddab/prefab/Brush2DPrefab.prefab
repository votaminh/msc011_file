%YAML 1.1
--- !Prefab &1
name: Brush2DPrefab
entities:
  - __class: Entity
    name: Brush2DEntity
    selfvisible: true
    tag: 0
    components:
      - {localId: 2}
      - __class: Brush2DComponent
        name: ""
        enabled: true
        curveType:
          __class: Brush2DCurveType
          value: Subdivision
        stablizerThreshold: 0
        smoothRadius: 1
        subdivisionLevel: 10
        resampleSpacing: 1
        meshType:
          __class: Brush2DMeshType
          value: Classical
        baseResolution: 1
        strokeSize:
          __class: Brush2DParam
          name: ""
          value: 100
          jitter: 0.0
          min: 0
          max: 4096
        strokeStep:
          __class: Brush2DParam
          name: ""
          value: 1.200000047683716
          jitter: 0
          min: 0
          max: 2
        stampStrategy:
          __class: Brush2DStampStrategy
          value: Restart
        uvIndex: 0
        colorBase: {r: 1, g: 1, b: 1, a: 1}
        colorJitter: {r: 0, g: 0, b: 0, a: 0}
        useOrient: true
        posJitter: {x: 0, y: 0}
        paintMode:
          __class: Brush2DPaintMode
          value: Paint
        strokeOpacity:
          __class: Brush2DParam
          name: ""
          value: 1
          jitter: 0
          min: 0
          max: 1
        brushMaterial: {localId: 1, path: material/Brush2DStroke.material}
        layerMaterial: {localId: 1, path: material/Brush2DLayer.material}
        blitMaterial: {localId: 1, path: material/Brush2DBlit.material}
    layer: 0
standaloneResources:
  __class: Map
--- !Transform &2
name: ""
enabled: true
localPosition: {x: 0, y: 0, z: 0}
localScale: {x: 1, y: 1, z: 1}
localOrientation: {w: 1, x: 0, y: 0, z: 0}
